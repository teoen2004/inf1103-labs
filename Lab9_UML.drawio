        <mxCell id="legend" parent="1" style="text;html=1;align=left;verticalAlign=top;spacing=8;strokeColor=#999999;fillColor=#f9f9f9;rounded=1;whiteSpace=wrap;" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Solid line = association (no ownership)&lt;br&gt;Hollow diamond = aggregation (whole: Inventory)&lt;br&gt;Filled diamond = composition (whole: Order)&lt;br&gt;Hollow triangle = inheritance&lt;br&gt;Dashed + hollow triangle = implements interface&lt;br&gt;Dashed + open arrow = dependency («creates»)&lt;br&gt;Underlined method = static method" vertex="1">
